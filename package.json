{
  "name": "hugo-site",
  "version": "1.0.0",
  "description": "Hugo static site with PDF generation",
  "scripts": {
    "dev": "hugo server -D",
    "build:html": "hugo --minify",
    "build:cv": "node scripts/generate-pdf.js",
    "build:theme-js": "cd themes/neoflux && pnpm run build:js",
    "build": "pnpm run build:theme-js && pnpm run build:html && pnpm run build:cv && pnpm run build:html"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "particles.js": "^2.0.0",
    "puppeteer": "^24.0.0",
    "tailwindcss": "^4.1.13",
    "yargs": "^17.7.2",
    "esbuild": "^0.27.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "puppeteer"
    ],
    "overrides": {
      "yargs": "^17.7.3"
    }
  }
}
